# Copia este archivo a .env y ajusta los valores
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DATABASE_URL=sqlite:///./festival.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
ORDER_EXPIRATION_MINUTES=15
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
# Administrador inicial (se crea al arrancar si no existe). Cámbialo en producción.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@laspalomasfestival.es
UPLOAD_DIR=uploads
# Inicio de sesión con GitHub (OAuth2). Déjalo vacío para desactivarlo.
# Crea una OAuth App en https://github.com/settings/developers con
# "Authorization callback URL" = http://localhost:5173/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
